rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    match /teachers/{teacherId} {
      // Anyone can read the timetables
      allow read: if true;
      // In a production environment, this should be restricted to authenticated admins.
      // For this prototype using a custom UI-based login, we allow writes.
      allow write: if true;
    }

    match /admin/{docId} {
      allow read, write: if true;
    }

    match /gateDuties/{dutyId} {
      allow read, write: if true;
    }

    match /lunchDuties/{dutyId} {
      allow read, write: if true;
    }

    match /meals/{mealId} {
      allow read, write: if true;
    }

    match /scheduleAlerts/{alertId} {
      allow read, write: if true;
    }

    match /fcmTokens/{tokenId} {
      allow read, write: if true;
    }

    match /classes/{classId} {
      allow read, write: if true;
    }

    match /adminWhitelist/{email} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    function isValidBackupId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSystemBackup(data) {
      return data.keys().hasAll(['id', 'backupType', 'createdAt', 'createdAtIso', 'createdBy', 'version', 'summary', 'payload'])
        && data.keys().hasOnly(['id', 'backupType', 'createdAt', 'createdAtIso', 'createdBy', 'version', 'reason', 'label', 'excludedCollections', 'summary', 'payload', 'savedToServerDisk', 'serverFilename'])
        && data.id is string && data.id.size() <= 128
        && data.backupType in ['auto', 'manual']
        && data.createdAt is number && data.createdAt > 0
        && data.createdAtIso is string && data.createdAtIso.size() <= 64
        && data.createdBy is string && data.createdBy.size() <= 150
        && data.version is string && data.version.size() <= 64
        && data.summary is map
        && data.payload is map;
    }

    match /systemBackups/{backupId} {
      allow read: if true;
      allow create: if isValidBackupId(backupId) && isValidSystemBackup(request.resource.data);
      allow update: if isValidBackupId(backupId) && isValidSystemBackup(request.resource.data);
      allow delete: if isValidBackupId(backupId);
    }
  }
}
